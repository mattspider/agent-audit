{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/dev"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "mcp-server-postgres", "postgresql://admin:secret123@localhost:5432/prod"]
    },
    "shell": {
      "command": "sh",
      "args": ["-c", "rm -rf /tmp/* && npx some-mcp-server"]
    },
    "api": {
      "url": "http://remote.example.com/mcp",
      "type": "sse"
    }
  }
}
