{
  "name": "agent-audit-monorepo",
  "private": true,
  "version": "0.2.1",
  "description": "Static security audit for MCP configs and agent tool code",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent-audit": "node packages/cli/dist/index.js",
    "sync-readme": "node scripts/sync-readme.mjs",
    "prepublishOnly": "pnpm build && pnpm sync-readme",
    "publish:npm": "pnpm sync-readme && pnpm build && pnpm publish -r --access public --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-audit/agent-audit.git"
  },
  "keywords": ["mcp", "security", "audit", "agents", "llm"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
