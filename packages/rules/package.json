{
  "name": "@agent-audit/rules",
  "version": "0.2.0",
  "description": "Built-in security rules for agent-audit",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/mattspider/agent-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattspider/agent-audit.git",
    "directory": "packages/rules"
  },
  "bugs": {
    "url": "https://github.com/mattspider/agent-audit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@agent-audit/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "keywords": ["mcp", "security", "rules", "agent-audit"],
  "engines": {
    "node": ">=20"
  }
}
