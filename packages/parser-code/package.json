{
  "name": "@agent-audit/parser-code",
  "version": "0.2.0",
  "description": "TypeScript and Python tool definition parser for agent-audit",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0"
  },
  "keywords": ["mcp", "agents", "parser", "typescript", "agent-audit"],
  "engines": {
    "node": ">=20"
  }
}
